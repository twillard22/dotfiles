diff --git a/Sources/AppBundle/util/NSRunningApplicationEx.swift b/Sources/AppBundle/util/NSRunningApplicationEx.swift
index 03be0ef3..decb584e 100644
--- a/Sources/AppBundle/util/NSRunningApplicationEx.swift
+++ b/Sources/AppBundle/util/NSRunningApplicationEx.swift
@@ -2,6 +2,25 @@ import AppKit
 
 extension NSRunningApplication {
     var idForDebug: String {
-        "PID: \(processIdentifier) ID: \(bundleIdentifier ?? executableURL?.description ?? "")"
+        "PID: \(resolvedPid) ID: \(bundleIdentifier ?? executableURL?.description ?? "")"
+    }
+
+    // macOS 27: NSRunningApplication reports -1 for some apps (e.g. Xcode 27's Device Hub)
+    // although LaunchServices knows the real pid. Fall back to matching the executable path.
+    var resolvedPid: pid_t {
+        let pid = processIdentifier
+        if pid != -1 { return pid }
+        guard let path = executableURL?.path else { return pid }
+        var pids = [pid_t](repeating: 0, count: 8192)
+        let count = unsafe proc_listallpids(&pids, Int32(pids.count * MemoryLayout<pid_t>.size))
+        var buf = [CChar](repeating: 0, count: 4 * Int(MAXPATHLEN))
+        for candidate in pids.prefix(Int(max(count, 0))) where candidate > 0 {
+            if unsafe proc_pidpath(candidate, &buf, UInt32(buf.count)) > 0,
+               String(cString: buf) == path
+            {
+                return candidate
+            }
+        }
+        return pid
     }
 }
