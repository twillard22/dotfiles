// oh-my-openagent routing. Symlinked to ~/.omo/omo.jsonc by setup.sh.
// Model IDs must exist in the provider blocks of opencode.jsonc; verify with
// `opencode models anthropic` / `opencode models openai` after `opencode auth login`.
// Providers: Anthropic + OpenAI via platform API keys only (no Google/Antigravity).
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  // This file is already in post-migration shape. The markers stop the plugin from
  // running its legacy migrations, whose writer refuses a symlinked target
  // ("Migration target is not an omo config path"). If a future plugin version adds a
  // new migration id and that error returns, see README.md → "omo migration error".
  "_migrations": ["2026-07-opencode-config-unification", "2026-08-reasoning-unification"],
  "[opencode]": {
    // Claude Code compat layer. OpenCode already loads ~/.claude/skills natively, so the
    // compat skill loader only added duplicates (`synced/<uuid>/docx` next to `docx`).
    // The figma/supabase Claude Code plugins added 15 skills and a stale remote Figma
    // MCP that can never auth (see README → "Add an MCP server"). Both are context
    // bloat with no OpenCode-side use; re-enable per key if that changes.
    "claude_code": {
      "skills": false,
      "plugins_override": {
        "figma@claude-plugins-official": false,
        "supabase@claude-plugins-official": false
      }
    },
    "agents": {
      // Orchestrator: plans, delegates, talks to the user. Its context is re-sent every
      // turn, so it is the cost lever. Fable by choice; drop to sonnet if spend balloons.
      "sisyphus": {"model": "anthropic/claude-fable-5-1", "reasoning": "medium"},
      // Planner, low volume.
      "prometheus": {"model": "anthropic/claude-fable-5-1", "reasoning": "max"},
      // Implementation worker.
      "hephaestus": {"model": "openai/gpt-5.6", "reasoning": "high"},
      // Architecture/debugging consult.
      "oracle": {"model": "openai/gpt-6-astra", "reasoning": "max"},
      // Strategy and critical review.
      "metis": {"model": "openai/gpt-5.6", "reasoning": "high"},
      "momus": {"model": "openai/gpt-5.6", "reasoning": "high"},
      // Docs/code search and context management.
      "librarian": {"model": "anthropic/claude-sonnet-5"},
      "atlas": {"model": "anthropic/claude-sonnet-5"},
      "explore": {"model": "anthropic/claude-haiku-4-5", "reasoning": "low"},
      // Needs image input; was Gemini in the source config.
      "multimodal-looker": {"model": "anthropic/claude-sonnet-5", "reasoning": "high"}
    },
    "categories": {
      "visual-engineering": {"model": "anthropic/claude-sonnet-5", "reasoning": "high"},
      "artistry": {"model": "anthropic/claude-sonnet-5", "reasoning": "high"},
      "ultrabrain": {"model": "openai/gpt-6-astra", "reasoning": "max"},
      "deep": {"model": "openai/gpt-6-astra", "reasoning": "max"},
      "quick": {"model": "anthropic/claude-haiku-4-5"},
      "writing": {"model": "anthropic/claude-sonnet-5"},
      "unspecified-low": {"model": "openai/gpt-5.6", "reasoning": "low"},
      "unspecified-high": {"model": "openai/gpt-5.6", "reasoning": "high"}
    }
  }
}
