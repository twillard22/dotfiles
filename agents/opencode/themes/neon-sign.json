{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "pink": "#ff3d8a",
    "hotpink": "#ff5edb",
    "indigo": "#8a7aff",
    "violet": "#b266ff",
    "cyan": "#5ee2ff",
    "blue": "#4d8aff",
    "green": "#5dff8f",
    "red": "#ff4d6d",
    "orange": "#ff7a3d",
    "yellow": "#ffb547",
    "text": "#e0d4f5",
    "subtle": "#9a87b8",
    "inactive": "#6b5a8a",
    "bg": "#08040f",
    "bgPanel": "#1a1438",
    "bgElement": "#2a1a4a",
    "border": "#4a2870",
    "borderSubtle": "#2d1f4d",
    "diffAddedBg": "#1f3a2a",
    "diffRemovedBg": "#3a1f28",
    "diffAddedDimmed": "#152a1f",
    "diffRemovedDimmed": "#2a151c",
    "diffAddedWord": "#2d6b42",
