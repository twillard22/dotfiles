{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "pink": "#e87aa8",
    "hotpink": "#d090c8",
    "indigo": "#a89ad8",
    "violet": "#b896d8",
    "cyan": "#8fcde0",
    "blue": "#7d95d8",
    "green": "#8de0a5",
    "red": "#e87a8a",
    "orange": "#e89870",
    "yellow": "#e8c074",
    "text": "#d8cee8",
    "subtle": "#b8a8d0",
    "inactive": "#8a7ba8",
    "bg": "#161025",
    "bgPanel": "#2d2548",
    "bgElement": "#3f3558",
    "border": "#5c4880",
    "borderSubtle": "#3d3360",
    "diffAddedBg": "#22382b",
    "diffRemovedBg": "#382226",
    "diffAddedDimmed": "#1c2a22",
